{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "web/*.js"
    }
  },
  "rewrites": [
    {
      "source": "/((?!favicon\\.ico$|favicon-32\\.png$|apple-touch-icon\\.png$|icon-192\\.png$|icon-512\\.png$|manifest\\.webmanifest$|og\\.jpg$|gear-logo-cutout\\.png$|prophecies/|uploads/|key/).*)",
      "destination": "/api"
    }
  ],
  "buildCommand": "npm run build:web"
}
